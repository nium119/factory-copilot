# 应用配置
APP_NAME=Factory Copilot
APP_VERSION=1.0.0
DEBUG=True

# API配置
API_PREFIX=/api
API_HOST=0.0.0.0
API_PORT=8000

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://47.103.96.248:8080"]

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# JWT配置
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Agent配置
AGENT_MODEL=qwen3.6-plus
AGENT_MAX_TOKENS=2000
AGENT_TEMPERATURE=0.7

# 模型提供商API密钥配置
# 阿里云百炼 (Qwen系列) - 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# DeepSeek (DeepSeek R1等) - 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI (GPT系列) - 获取地址: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# MCP 集成配置 (JSON 数组，每项包含 name/command/args)
# 示例连接本地 Demo MCP Server
MCP_SERVERS=[{"name":"demo","command":"python","args":["-m","app.mcp.server"]}]

# A2A 外部 Agent 配置 (JSON 数组，每项包含 name/display_name/command/args/default_tool)
# 示例: [{"name":"sap-bot","display_name":"SAP助手","command":"python","args":["-m","external.sap_agent"],"default_tool":"process"}]
A2A_EXTERNAL_AGENTS=[]

# 资源感知优化配置
# 启用后系统根据并发数/API频率/token预算动态调整并发度和模型选择
RESOURCE_AWARE_ENABLED=True
MAX_CONCURRENT_REQUESTS=10

# MES CLI 配置
# 设为 true 时 Agent 通过 CLI 获取真实 MES 数据，false 时使用模拟数据
MES_API_ENABLED=false
MES_CLI_PATH=mes-cli

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days

# 监控配置
ENABLE_METRICS=True
METRICS_PORT=9090
