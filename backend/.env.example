# 应用配置
APP_NAME=Factory Copilot
APP_VERSION=1.0.0
DEBUG=True

# API配置
API_PREFIX=/api
API_HOST=0.0.0.0
API_PORT=8001

# CORS配置
CORS_ORIGINS=["http://localhost:3001"]

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Agent配置
AGENT_MODEL=qwen3.6-plus
AGENT_MAX_TOKENS=2000
AGENT_TEMPERATURE=0.7
ROUTING_METHOD=keyword  # keyword | llm — Agent 路由策略（llm=语义理解，keyword=关键词匹配）

# 模型提供商API密钥配置
# 阿里云百炼 (Qwen系列) - 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# DeepSeek (DeepSeek R1等) - 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# OpenAI (GPT系列) - 获取地址: https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# MCP 集成配置 (JSON 数组，每项包含 name/command/args)
# ⚠ 安全提醒: command 必须为绝对路径或 PATH 中的可执行文件，系统会在启动时校验
MCP_SERVERS=[{"name":"demo","command":"python","args":["-m","app.mcp.server"]}]

# A2A 外部 Agent 配置 (JSON 数组，每项包含 name/display_name/command/args/default_tool)
A2A_EXTERNAL_AGENTS=[]

# API 鉴权 Token（可选，留空则不启用鉴权）
# 设置后所有 /api/ 请求需携带 Authorization: Bearer <token> 头
API_AUTH_TOKEN=

# 资源感知优化配置
# 启用后系统根据并发数/API频率/token预算动态调整并发度和模型选择
RESOURCE_AWARE_ENABLED=True
MAX_CONCURRENT_REQUESTS=10

# MES CLI 配置
# 设为 true 时 Agent 通过 CLI 获取真实 MES 数据，false 时使用模拟数据
MES_API_ENABLED=false
MES_CLI_PATH=mes-cli


# Neo4j 项目命名空间隔离（与 OntoStudio 推送时使用的 namespace 一致）
# 为空时不过滤，兼容旧数据
NEO4J_NAMESPACE=manufacturing

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
