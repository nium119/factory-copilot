# ═══════════════════════════════════════════════════════════════
# 部署模式说明
# ═══════════════════════════════════════════════════════════════
# 独立部署: 前端+后端同域(Docker 9004端口), 无需跨域配置
#   VITE_ENV_SITE=main
#   # VITE_BASE=./                         ← 默认, 可不写
#   # VITE_API_BASE_URL=/api               ← 同域, 可不写
#
# 子应用部署: 前端部署到 IIS 子应用(/AI-OS/), 后端在 Docker(172.21.10.22:9004)
#   VITE_ENV_SITE=main-sub
#   VITE_BASE=/AI-OS/                      ← 必须! 资源路径前缀
#   VITE_API_BASE_URL=http://172.21.10.22:9004/api  ← 必须! 跨域后端地址
# ═══════════════════════════════════════════════════════════════

# 当前: 子应用部署
VITE_ENV_SITE=main-sub
VITE_BASE=/AI-OS/
VITE_API_BASE_URL=http://172.21.10.22:9004/api
