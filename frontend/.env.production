# 生产环境配置
# 构建: npm run build

#──── 璟岩MES（main 站点，默认）────────────────────
# VITE_ENV_SITE=main
# VITE_API_BASE_URL=http://172.21.10.22:9004/api

#──── 子站点独立部署 ──────────────────────────────
# VITE_ENV_SITE=main-sub
# VITE_API_BASE_URL=http://<target-host>/api

#──── 子应用（wujie，菜单由父应用 __MENU_CONFIG__ 控制）─
VITE_ENV_SITE=main-sub
VITE_API_BASE_URL=http://172.21.10.22:9004/api
